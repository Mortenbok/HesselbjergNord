# Foreningens faste dokumenter (vedtægter m.m.). Mappen ligger med vilje
# inde i public_html, så den følger med ved udgivelse — men filerne må kun
# hentes gennem de PHP-sider, der kræver login. Direkte adgang er spærret.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# Ekstra sikkerhed: kør aldrig scripts, der måtte være havnet her.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
AddType text/plain .php .phtml .phar .cgi .pl .py
